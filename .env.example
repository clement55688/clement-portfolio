# Optional. Worker secrets (wrangler secret put). Without them, guestbook, views,
# and scores stay in memory and reset with each Workers isolate.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required at build time. Next inlines NEXT_PUBLIC_* into the bundle.
# workers.dev host for the clement-portfolio worker. Same account as the arcade:
NEXT_PUBLIC_SITE_URL=https://clement-portfolio.a2040404.workers.dev

# Optional, inlined at build time and shown by /api/status.
NEXT_PUBLIC_BUILD_TIME=

# Optional runtime Worker var (not inlined). Shown by /api/status.
# GIT_COMMIT_SHA=
