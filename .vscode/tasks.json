{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install locked dependencies (both apps)",
      "type": "shell",
      "command": "pnpm",
      "windows": { "command": "pnpm.cmd" },
      "args": ["run", "setup:local"],
      "problemMatcher": []
    },
    {
      "label": "Play: arcade (4173)",
      "type": "shell",
      "command": "pnpm",
      "windows": { "command": "pnpm.cmd" },
      "args": ["run", "dev:games"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Run: portfolio (3000)",
      "type": "shell",
      "command": "pnpm",
      "windows": { "command": "pnpm.cmd" },
      "args": ["run", "dev"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Verify: arcade build + tests",
      "type": "shell",
      "command": "pnpm",
      "windows": { "command": "pnpm.cmd" },
      "args": ["run", "test:games"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Lint: repository",
      "type": "shell",
      "command": "pnpm",
      "windows": { "command": "pnpm.cmd" },
      "args": ["run", "lint"],
      "problemMatcher": []
    },
    {
      "label": "Build: portfolio",
      "type": "shell",
      "command": "pnpm",
      "windows": { "command": "pnpm.cmd" },
      "args": ["run", "build"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Verify: everything",
      "type": "shell",
      "command": "pnpm",
      "windows": { "command": "pnpm.cmd" },
      "args": ["run", "check:all"],
      "problemMatcher": []
    }
  ]
}
