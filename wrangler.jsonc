{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clement-portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Branch and pull request previews (`wrangler preview`, run by Workers Builds).
  // Bindings and secrets are not inherited, so previews never touch production storage.
  "previews": {},
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "clement-portfolio"
    }
  ]
}
